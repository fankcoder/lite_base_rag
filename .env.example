# ==================== Embedding 配置 ====================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_BATCH_SIZE=32

# ==================== Milvus 配置 ====================
MILVUS_TYPE=lite
MILVUS_DB_PATH=./data/milvus/milvus.db
MILVUS_COLLECTION=knowledge_base
MILVUS_VECTOR_DIM=512
MILVUS_METRIC=COSINE
MILVUS_INDEX_TYPE=FLAT

# ==================== 文档解析配置 ====================
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=50
MAX_CHUNK_SIZE=1000

# ==================== 检索配置 ====================
RETRIEVE_TOP_K=10
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=5
BM25_ENABLED=true
SIMILARITY_THRESHOLD=0.5

# ==================== LLM 配置 ====================
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_STREAMING=true

# ==================== 服务配置 ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
API_KEY=
CORS_ORIGINS=*

# ==================== 知识库配置 ====================
KNOWLEDGE_DIR=./data/uploads
AUTO_INDEX=false
SCAN_INTERVAL=3600

# ==================== HuggingFace 镜像 ====================
# 国内用户建议设置
HF_ENDPOINT=https://hf-mirror.com
